{
  "name": "mscz-voting-platform",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "prepare": "vp config && svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "vp fmt --check . && vp lint .",
    "format": "vp fmt .",
    "db:start": "docker compose up",
    "db:reset": "tsx --env-file=.env src/lib/server/db/reset.ts",
    "db:seed": "tsx --env-file=.env src/lib/server/db/seed.ts",
    "db:seed2": "tsx --env-file=.env src/lib/server/db/seed_v2.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
  },
  "dependencies": {
    "@lucide/svelte": "^1.77.0",
    "theme-change": "^3.0.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^8.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "auth": "^1.7.27",
    "better-auth": "^1.7.27",
    "daisyui": "^5.8.2",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "drizzle-seed": "^0.3.1",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "postgres": "^3.4.9",
    "repomix": "^1.19.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  }
}
